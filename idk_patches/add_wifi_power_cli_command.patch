+static void tx_power_wifi_command(char *pcWriteBuffer, int xWriteBufferLen, int argc, char **argv)
+{
+    float wifi_pwr;
+    double wifi_power;
+    int standard;
+    if(argc == 2)
+    {
+        if(strlen(argv[1]) != 1)
+        {
+            os_printf("cmd parameter error\r\n");
+            return;
+        }
+        standard = *argv[1]-'0';
+        if(standard == WIFI_STANDARD_11B)
+        {
+            bk_wifi_get_tx_power(WIFI_STANDARD_11B, &wifi_pwr);
+            os_printf("Tx_pwr_wifi: %f\r\n", wifi_pwr);
+        }
+        else if(standard == WIFI_STANDARD_11G)
+        {
+            bk_wifi_get_tx_power(WIFI_STANDARD_11G, &wifi_pwr);
+            os_printf("Tx_pwr_wifi: %f\r\n", wifi_pwr);
+        }
+        else if(standard == WIFI_STANDARD_11N)
+        {
+            bk_wifi_get_tx_power(WIFI_STANDARD_11N, &wifi_pwr);
+            os_printf("Tx_pwr_wifi: %f\r\n", wifi_pwr);
+        }
+		else if(standard == WIFI_STANDARD_11AX)
+        {
+            bk_wifi_get_tx_power(WIFI_STANDARD_11AX, &wifi_pwr);
+            os_printf("Tx_pwr_wifi: %f\r\n", wifi_pwr);
+        }
+        else
+        {
+            os_printf("invalid cmd\r\n");
+        }
+    }
+    else if(argc == 3)
+    {
+        if(strlen(argv[1]) != 1)
+        {
+            os_printf("cmd parameter error\r\n");
+            return;
+        }
+        standard = *argv[1]-'0';
+        wifi_power = strtod(argv[2], NULL);
+        wifi_pwr = (float)wifi_power;
+        if(standard == WIFI_STANDARD_11B)
+        {
+        bk_wifi_set_tx_power(WIFI_STANDARD_11B, wifi_pwr);
+        os_printf("Set Tx_pwr_wifi: %f\r\n", wifi_pwr);
+        }
+        else if(standard == WIFI_STANDARD_11G)
+        {
+        bk_wifi_set_tx_power(WIFI_STANDARD_11G, wifi_pwr);
+        os_printf("Set Tx_pwr_wifi: %f\r\n", wifi_pwr);
+        }
+        else if(standard == WIFI_STANDARD_11N)
+        {
+        bk_wifi_set_tx_power(WIFI_STANDARD_11N, wifi_pwr);
+        os_printf("Set Tx_pwr_wifi: %f\r\n", wifi_pwr);
+        }
+		else if(standard == WIFI_STANDARD_11AX)
+        {
+        bk_wifi_set_tx_power(WIFI_STANDARD_11AX, wifi_pwr);
+        os_printf("Set Tx_pwr_wifi: %f\r\n", wifi_pwr);
+        }
+        else
+        {
+        os_printf("invalid cmd\r\n");
+        }
+    }
+    else
+    {
+      os_printf("invalid cmd\r\n");
+    }
+}
