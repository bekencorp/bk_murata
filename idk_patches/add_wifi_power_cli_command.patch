+void wifi_countrycode_command(char *pcWriteBuffer, int xWriteBufferLen, int argc, char **argv)
+{
+	int ret;
+	char *msg = NULL;
+    char * p_countrycode = NULL;
+    wifi_country_t wifi_country;
+    if(argc == 1)
+    {
+        ret = bk_wifi_get_country(&wifi_country);
+        if(!ret)
+        {
+			CLI_LOGI("wifi_country: %s\r\n", wifi_country.cc);
+			msg = WIFI_CMD_RSP_SUCCEED;
+        }
+        else
+        {
+            CLI_LOGI("Get wifi_country Failed %d\r\n", ret);
+			msg = WIFI_CMD_RSP_ERROR;
+        }
+    }
+    else if(argc == 2)
+    {
+        memset(&wifi_country,0 ,sizeof(wifi_country_t));
+        p_countrycode = argv[1];
+        if(strlen(p_countrycode) != 2)
+        {
+            CLI_LOGI("length error %d\r\n", strlen(p_countrycode));
+			msg = WIFI_CMD_RSP_ERROR;
+        }
+        else
+        {
+            for(int i=0;i<5;i++)
+            {
+                if((p_countrycode[0]==wifi_country_list[i].cc[0]) && (p_countrycode[1]==wifi_country_list[i].cc[1]))
+                {
+                    memcpy(&wifi_country,&wifi_country_list[i],sizeof(wifi_country_t));
+                    break;
+                }
+            }
+            if(wifi_country.cc[0] == 0x00)
+            {
+                CLI_LOGI("Not supported country code %s\r\n", p_countrycode);
+				msg = WIFI_CMD_RSP_ERROR;
+            }
+            else
+            {
+                ret = bk_wifi_set_country(&wifi_country);
+                if(!ret)
+                {
+                    CLI_LOGI("Set wifi_country: %s\r\n", wifi_country.cc);
+					msg = WIFI_CMD_RSP_SUCCEED;
+                }
+                else
+                {
+                    CLI_LOGI("Set wifi_country Failed %d\r\n", ret);
+					msg = WIFI_CMD_RSP_ERROR;
+                }
+            }
+        }
+    }
+    else
+    {
+        CLI_LOGI("invalid cmd\r\n");
+		msg = WIFI_CMD_RSP_ERROR;
+    }
+	os_memcpy(pcWriteBuffer, msg, os_strlen(msg));
+    return ;
+
+}
